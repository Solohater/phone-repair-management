{
  "name": "mobile-repair-shop",
  "version": "1.0.0",
  "private": true,
  "description": "Mobile Repair Shop Management",
  "scripts": {
    "dev:api": "npm run dev --prefix api",
    "dev:web": "npm start --prefix web",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "install:all": "npm install --prefix api && npm install --prefix web",
    "db:migrate": "npm run db:migrate --prefix api",
    "db:studio": "npm run db:studio --prefix api"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
